# ==============================================================================
# Industrial Predictive Maintenance System - Environment Configuration
# ==============================================================================

# Project Details
PROJECT_NAME="Industrial Predictive Maintenance System"
ENVIRONMENT=development
DEBUG=True

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=your_secret_key_here

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=industrial_maintenance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/industrial_maintenance

# Frontend Configuration
FRONTEND_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# Telemetry Generator & Simulation Settings
SIMULATION_INTERVAL_SECONDS=2
ANOMALY_INJECTION_RATE=0.05
